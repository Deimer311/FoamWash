# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DB_HOST=localhost # Database host
DB_PORT=3306      # Database port
DB_USER=root     # Database user
DB_PASSWORD= # Database password, no tiene contraseña
DB_NAME=foam_wash_db # Database name

#===============================================================================
# POOL DE CONEXIONES (PARA OPTIMIZAR)
#===============================================================================
DB_CONNECTION_LIMIT=10 # Número máximo de conexiones en el pool
DB_QUEUE_LIMIT=0      # Número máximo de solicitudes en cola (0 = sin límite)

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# IMPORTANTE: Cambia este secreto en producción
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=daae03f383b3553b5611ac5a4bc52912ecc8922b4648ba4e3e3f45cd1647d46e373615bc2c5e5e4aaa76d99bd2f6a29ea2ccc850d9d499edf9c45e1f911e404a #este debe cambiarse en produccion
JWT_EXPIRES_IN=7d# Duración del token JWT (ejemplo: 7d = 7 día)
JWT_REFRESH_SECRET=otro_secreto_diferente_para_refresh_tokens #tambien es necesario cambiar en produccion.
JWT_REFRESH_EXPIRES_IN=30d #Duracion del token JWT es de 30 dias.

#===============================================================================
# SERVER CONFIGURATION
#===============================================================================
NODE_ENV=development # Entorno de ejecución (development, production)
PORT=5001           # Puerto en el que correrá el servidor
BASE_URL=http://localhost:5001 # URL base del servidor
API_VERSION=v1

#===============================================================================
#SEGURITY
#===============================================================================
#CORS - Frontend URL permitida
#===============================================================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

#Rate Limiting
RATE_LIMIT_WINDOW_MS=900000     # 15 minutos en milisegundos
RATE_LIMIT_MAX_REQUESTS=100     # Máximo de peticiones por ventana
AUTH_RATE_LIMIT_MAX=5           # Máximo intentos de login

# Bcrypt
BCRYPT_SALT_ROUNDS= 10          # Número de rondas para el hash de contraseñas
# ==============================================================================
#EMAIL CONFIGURATION
# ==============================================================================
# EMAIL_HOST: Servidor SMTP que se usará para enviar correos
# Gmail usa smtp.gmail.com como servidor de salida
EMAIL_HOST=smtp.gmail.com

# EMAIL_PORT: Puerto de conexión al servidor SMTP
# 587 es el puerto estándar para SMTP con encriptación TLS/STARTTLS
# (Otros puertos comunes: 465 para SSL, 25 sin encriptación)
EMAIL_PORT=587

# EMAIL_USER: Dirección de correo electrónico que se autenticará en el servidor
# Esta es la cuenta de Gmail desde la cual se enviarán los correos
EMAIL_USER=your_email@gmail.com # Dirección de correo de Gmail, debe cambiarse por uno funcional

# EMAIL_PASSWORD: Contraseña de aplicación para autenticación
# IMPORTANTE: NO uses tu contraseña de Gmail normal
# Debes generar una "contraseña de aplicación" desde la configuración de seguridad de Google
# (Configuración > Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones)
EMAIL_PASSWORD=your_app_password # Contraseña de aplicación generada, debe cambiarse por una funcional

# EMAIL_FROM: Dirección de correo que aparecerá como remitente
# Formato: "Nombre Visible <dirección@dominio.com>"
# Los usuarios verán "FoamWash" como remitente en su bandeja de entrada
EMAIL_FROM=FoamWash <noreply@foamwash.com>

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
# Define el nivel mínimo de severidad para los mensajes de registro (logging).
# 'info' significa que se registrarán mensajes de nivel INFO, WARNING, ERROR y CRITICAL.
# Otros valores comunes incluyen 'debug' (más detallado) o 'error' (solo errores graves).
LOG_LEVEL=info