{
  "name": "foamwash-backend",
  "version": "2.0.0",
  "description": "Foam Wash API - NestJS + Prisma",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:studio": "prisma studio",
    "test": "npm run test:all",
    "test:unit": "jest --verbose \"pruebas unitarias\"",
    "test:calidad": "jest --verbose \"pruebas de calidad\"",
    "test:watch": "jest --watch",
    "test:cov": "npx prisma db push --schema=prisma/schema.test.prisma --force-reset --accept-data-loss && jest --coverage --runInBand",
    "test:all": "powershell -ExecutionPolicy Bypass -File scripts/run-all-tests.ps1",
    "test:rendimiento": "artillery run \"src/test/pruebas rendimiento/escenario_estres.yml\" --output test-reports/reporte_rendimiento.json && node scripts/generate-artillery-html.js test-reports/reporte_rendimiento.json test-reports/reporte_rendimiento.html",
    "test:rendimiento:autenticacion": "artillery run \"src/test/pruebas rendimiento/escenario_autenticacion.yml\" --output test-reports/reporte_autenticacion.json && node scripts/generate-artillery-html.js test-reports/reporte_autenticacion.json test-reports/reporte_autenticacion.html",
    "test:rendimiento:reservas": "artillery run \"src/test/pruebas rendimiento/escenario_reservas.yml\" --output test-reports/reporte_reservas.json && node scripts/generate-artillery-html.js test-reports/reporte_reservas.json test-reports/reporte_reservas.html",
    "sonar": "npx sonarqube-scanner"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "firebase-admin": "^14.1.0",
    "helmet": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "artillery": "^2.0.33",
    "jest": "^30.4.2",
    "jest-html-reporters": "^3.1.7",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.1.3"
  }
}
